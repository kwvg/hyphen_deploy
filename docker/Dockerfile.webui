# syntax=docker/dockerfile:1

FROM node:24-bookworm-slim AS builder

RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

WORKDIR /src

RUN --mount=type=bind,from=src,target=/ctx \
    --mount=type=cache,target=/root/.local/share/pnpm/store \
    cp /ctx/package.json /ctx/pnpm-lock.yaml /ctx/pnpm-workspace.yaml /ctx/.npmrc /ctx/.nvmrc /src/ && \
    cp -r /ctx/app /src/app && \
    cp -r /ctx/contrib /src/contrib && \
    pnpm install --frozen-lockfile && \
    pnpm build

FROM lscr.io/linuxserver/nginx:latest

COPY --from=builder /src/app/webui/public /config/www/
